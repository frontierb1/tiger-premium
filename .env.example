# ===== คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env) =====

# ----- LINE Messaging API (Channel ที่เป็น Bot / OA) -----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ----- LINE Login channel ที่ผูกกับ LIFF -----
# ⚠️ จำเป็น! ถ้าไม่ตั้ง ระบบจะเชื่อ lineUserId ที่ client ส่งมา (ปลอมได้)
# หาได้ที่ LINE Developers > (LINE Login channel) > Basic settings > Channel ID
# เป็นตัวเลขล้วน ไม่ใช่ LIFF ID
LINE_LOGIN_CHANNEL_ID=

# LIFF ID (ใช้ในหน้าเว็บ)
LIFF_ID=

# ----- Google Sheets -----
SHEET_ID=
# JSON ทั้งก้อนของ Service Account (ใส่เป็นบรรทัดเดียว)
GOOGLE_CREDENTIALS=

# ----- EasySlip (ตรวจสลิป) -----
EASYSLIP_API_KEY=

# ----- Admin -----
# แบบที่ 1 (แนะนำ): กำหนดหลายคนพร้อมกัน — status ใส่หรือไม่ใส่ก็ได้ (default = active)
# ADMINS_JSON=[{"username":"boss","password":"xxxx","displayName":"เจ้าของ","role":"owner"},{"username":"staff","password":"yyyy","displayName":"แอดมิน","role":"admin"}]
ADMINS_JSON=

# แบบที่ 2: กำหนดทีละคน (ใช้เมื่อไม่ได้ตั้ง ADMINS_JSON)
OWNER_USER=
OWNER_PASS=
OWNER_NAME=Owner
ADMIN_USER=
ADMIN_PASS=
ADMIN_NAME=Admin

# LINE user id ของแอดมิน — ใช้รับแจ้งเตือนเมื่อลูกค้าแจ้งปัญหา (ไม่ใส่ก็ได้)
ADMIN_LINE_ID=

# ----- Cron แจ้งเตือน -----
# กุญแจสำหรับเรียก GET /run-notify?key=xxx (ตั้งเป็นค่าสุ่มยาวๆ)
NOTIFY_KEY=

# ----- ทั่วไป -----
# ชื่อแบรนด์ที่ใช้ในข้อความ LINE (ชื่อบนหน้าเว็บตั้งแยกที่ public/liff/config.js)
BRAND_NAME=Premium Family
BASE_URL=https://your-app.up.railway.app
NODE_ENV=production
# เขตเวลาที่ใช้คำนวณวันหมดอายุ (default: Asia/Bangkok)
APP_TZ=Asia/Bangkok
# อายุ cache ของข้อมูลจาก Google Sheets เป็นมิลลิวินาที (default 15000, ใส่ 0 เพื่อปิด)
CACHE_TTL_MS=15000
